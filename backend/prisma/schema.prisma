generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model UserRole {
  id          String    @id @default(uuid())
  name        String
  description String
  level       Int       @default(1)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime? @updatedAt
  deletedAt   DateTime?
  users       User[]

  @@map("user_roles")
}

model User {
  id            String    @id @default(uuid())
  name          String
  email         String    @unique
  password_hash String?
  joker         Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime?
  deletedAt     DateTime?

  roleId   String
  userRole UserRole? @relation(fields: [roleId], references: [id])

  createdByUser   Client[]          @relation("CreatedBy")
  linkedByUser    Client[]          @relation("ResponsibleBy")
  importedProcess ImportedProcess[]

  @@map("users")
}

model Client {
  id                    String    @id @default(uuid())
  protocol              String    @unique
  tradeName             String
  dataFundation         DateTime
  createdAt             DateTime  @default(now())
  updatedAt             DateTime? @updatedAt
  correspondenceAddress String
  createdById           String
  isActivated           Boolean
  legalName             String
  locationAddress       String
  nameContact           String
  numberContact         String
  responsibleById       String
  type                  Int

  representatives    Representative[]
  createdBy          User                @relation("CreatedBy", fields: [createdById], references: [id])
  responsibleBy      User                @relation("ResponsibleBy", fields: [responsibleById], references: [id])
  orders             Order[]
  clientAppointments ClientAppointment[]
  ClientProcess      ClientProcess[]
  publications       Publication[]

  @@map("clients")
}

model ProcessCategory {
  id String @id @default(uuid())

  name        String
  description String
  slug        String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime? @updatedAt
  deletedAt   DateTime?

  processHistories  ProcessHistory[]
  importedProcess   ImportedProcess[]

  @@map("process_categories")
}

model ProcessHistory {
  id String @id @default(uuid())

  numberMagazine String   @unique
  categoryId     String
  fileName       String
  filePath       String
  createdAt      DateTime @default(now())

  category ProcessCategory @relation(fields:[categoryId], references: [id])

  importedProcess ImportedProcess[]

  @@map("process_histories")
}

model ProcessType {
  id          String    @id @default(uuid())
  slug        String    @unique
  name        String
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime? @updatedAt
  deletedAt   DateTime?

  importedProcess ImportedProcess[]
  publications       Publication[]

  @@map("process_types")
}

model ImportedProcess {
  id                String    @id @default(uuid())
  processHistoricId String
  processCategoryId String
  processTypeId     String

  processNumber                   String
  holder                          String
  dispatchDetails                 String? @db.Text
  attorney                        String?
  presentation                    String?
  nature                          String?
  markName                        String? 
  ncl                             String?
  specification                   String?
  translatedSpecification         String?
  internationalRegistrationNumber String?
  cfe                             String?

  status          String
  sourceText      String @db.Text
  sourcePage      Int  
  importedByUser  String
  depositDate     DateTime?
  receivedDate    DateTime?
  grantDate       DateTime?
  createdAt       DateTime  @default(now())

  processHistoric ProcessHistory @relation(fields: [processHistoricId], references: [id])
  processCategory ProcessCategory @relation(fields: [processCategoryId], references: [id])
  processType     ProcessType?    @relation(fields: [processTypeId], references: [id])
  user            User            @relation(fields: [importedByUser], references: [id])

  @@map("imported_processes")
}

model Publication {
  id                String @id @default(cuid())
  processTypeId     String
  clientId          String

  processNumber String
  holder        String
  brand         String
  nature        String
  specification String @db.Text
 
  publicationDate DateTime?
  depositDate     DateTime?
  grantDate       DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime? @updatedAt
  deletedAt   DateTime?

  processType     ProcessType?    @relation(fields: [processTypeId], references: [id])
  client          Client @relation(fields: [clientId], references: [id])

  @@map("publications")
}

model PublicationHistory {
  id                          String @id @default(cuid())
  processHistoryId            String
  processBrandPublicationId   String
  processNumber               String
  dispatch                    String
  complement                  String
  publicationDate             DateTime
  providence                  String
  createdAt   DateTime @default(now())
  updatedAt   DateTime? @updatedAt
  deletedAt   DateTime?

  @@map("PublicationHistories")
}

model ClientProcess {
  id            String    @id @default(uuid())
  clientId      String
  processNumber String
  assignedAt    DateTime  @default(now())
  notes         String?   @db.Text
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime? @updatedAt
  deletedAt     DateTime?

  client Client @relation(fields: [clientId], references: [id])

  @@map("client_processes")
}

model ClientAppointment {
  id            String    @id @default(uuid())
  clientId      String
  orderId       String?
  description   String
  appointmentAt DateTime
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  client Client @relation(fields: [clientId], references: [id])
  Order  Order? @relation(fields: [orderId], references: [id])

  @@map("client_appointments")
}

model Representative {
  id          String    @id @default(uuid())
  name        String
  nationality String
  documentRG  String
  documentCPF String
  titleJob    String
  roleJob     String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime? @updatedAt
  deletedAt   DateTime?

  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  @@map("representatives")
}

model OrderType {
  id          Int       @id @default(autoincrement())
  title       String
  descripton  String
  observation String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime? @updatedAt
  deletedAt   DateTime?
  orders      Order[]

  @@map("order_types")
}

model Order {
  id          String    @id @default(uuid())
  clientId    String
  orderTypeId Int
  description String
  observation String?
  eventDate   DateTime
  createdAt   DateTime  @default(now())
  updatedAt   DateTime? @updatedAt
  deletedAt   DateTime?

  client             Client              @relation(fields: [clientId], references: [id])
  orderType          OrderType           @relation(fields: [orderTypeId], references: [id])
  payments           Payment[]
  clientAppointments ClientAppointment[]

  @@map("orders")
}

model Payment {
  id                String   @id @default(uuid())
  orderId           String
  totalInstallments Int
  observation       String?
  firstDueDate      DateTime

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt
  deletedAt DateTime?

  order               Order                @relation(fields: [orderId], references: [id])
  paymentInstallments PaymentInstallment[]

  @@map("payments")
}

model PaymentInstallment {
  id                String  @id @default(uuid())
  paymentId         String
  installment       Int
  methodId          String
  amountInCents     Int
  adjustmentInCents Int?
  observation       String?

  dueDate         DateTime
  paidAt          DateTime?
  receiptFilePath String?

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt
  deletedAt DateTime?

  payment       Payment       @relation(fields: [paymentId], references: [id])
  paymentMethod PaymentMethod @relation(fields: [methodId], references: [id])

  @@map("payment_installments")
}

model PaymentMethod {
  id          String  @id @default(uuid())
  name        String
  observation String?
  order       Int

  createdAt          DateTime             @default(now())
  updatedAt          DateTime?            @updatedAt
  deletedAt          DateTime?
  PaymentInstallment PaymentInstallment[]

  @@map("payment_methods")
}
